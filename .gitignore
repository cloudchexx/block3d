# ============================================================
# Block3D library source — .gitignore
# Target: CMake + C/C++ + optional Python bindings on Windows
# ============================================================

# ---------- Build directories ----------
build/
build-*/
[Oo]ut/
cmake-build-*/
cmake-build-debug/
cmake-build-release/
.vs/

# ---------- Install / packaging output (regenerated by cmake --install) ----------
install/

# ---------- CMake generated files ----------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
Makefile
*.ninja
*.cmake.stamp

# ---------- Compiled binaries / object files ----------
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb
*.ilk
*.exp
*.idb
*.pch

# ---------- Runtime / generated data ----------
work/
run_cache/
*.b3d.cache
*.scrub
# Benchmark / CLI transient logs, but keep the committed test fixture data below.
*.log
!tests/fixtures/*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.whl
dist/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
.python-version

# ---------- IDE / editor ----------
.idea/
.vscode/
.fleet/
*.user
*.userosscache
*.swp
*.swn
*.swo

# ---------- OS / misc ----------
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
